*filter
:INPUT DROP [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:trusted-hosts - [0:0]
:trusted-providers - [0:0]
:limited-hosts - [0:0]
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -i lo -j ACCEPT
-A INPUT -p icmp --icmp-type echo-reply -j ACCEPT
-A INPUT -p icmp --icmp-type destination-unreachable -j ACCEPT
-A INPUT -p icmp --icmp-type time-exceeded -j ACCEPT
-A INPUT -p tcp --dport 22 -j trusted-hosts
-A INPUT -p tcp --dport 443 -j trusted-hosts
-A INPUT -p tcp --dport 80 -j trusted-hosts
-A INPUT -p tcp -m multiport --dports 81,4443,8001,8003 -j trusted-hosts
-A INPUT -p udp --dport 5060:5069 -j trusted-providers
-A INPUT -p udp --dport 4569 -j trusted-providers
-A INPUT -p udp --dport 1194 -j -m comment --comment "OpenVPN UDP Handshake" -j ACCEPT
-A INPUT -p tcp --dport 1194 -j -m comment --comment "OpenVPN TCP Handshake" -j ACCEPT
-A INPUT -i tun+ -p tcp --dport 22 -j ACCEPT
-A INPUT -i tun+ -p tcp --dport 443 -j ACCEPT
-A INPUT -i tun+ -p udp --dport 5060:5069 -j ACCEPT
-A INPUT -p udp -m udp --dport 4569 -j ACCEPT
-A INPUT -p udp -m udp --dport 10000:20000 -j ACCEPT

-A INPUT -m limit --limit 5/min -j LOG --log-prefix "iptables-drop: " --log-level 4 
-A INPUT -j DROP

