#!/bin/bash
DN="\Z1\ZrDN\Z0\ZR";
UP="\Zr\Z2UP\Z0\ZR";
NA="\Z8\ZrNA\Z0\ZR";
if hostname -I > /etc/hostip; then

    _IP="LAN IP: $(hostname -I | xargs)"

    if [ -f "/etc/pbx/.phone" ]; then
        _PHONE=$(cat /etc/pbx/.phone)
    else
        _PHONE=""
    fi

    _PUBLIC="Public: $(curl -4 -s https://ifconfig.co) $_PHONE"
else
    _IP=""
    _PUBLIC="Public: $(curl -4 -s https://ifconfig.co) $_PHONE"
fi

version=$(cat /etc/pbx/.version)

phpversion=$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')

astversion=$(asterisk -rx "core show version" | awk '/Asterisk/{print $2; exit}')

fpbxversion=$(grep -m1 '<version>' /var/www/html/admin/modules/core/module.xml | sed 's|.*<version>\(.*\)</version>.*|\1|')



source /etc/os-release
OSrelease="$PRETTY_NAME"


service_status() {
    local service="$1"

    if systemctl is-active --quiet "$service"; then
        echo "$UP"
    else
        echo "$DN"
    fi
}

if asterisk -rx "core show uptime" >/dev/null 2>&1; then
    asterisk="$UP"
else
    asterisk="$DN"
fi
apache=$(service_status apache2)
mysql=$(service_status mariadb)
ssh=$(service_status ssh)
fail2ban=$(service_status fail2ban)
webmin=$(service_status webmin)
knockd=$(service_status knockd)
knockd=$(service_status postfix)







test=`ps aux | grep -c ntpd`
if [ "$test" -lt "2" ]; then
 ntpd="$DN"
else
 ntpd="$UP"
fi
#iptables status
if iptables -S | grep -q '^-P INPUT DROP'; then
    IPtables="$UP"
else
    IPtables="$DN"
fi

IPPORT=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
# fallback for weird VPS setups (like venet)
if [ -z "$IPPORT" ]; then
    IPPORT=$(ip -o link show | awk -F': ' '{print $2}' | grep -v lo | head -n 1)
fi
# detect venet explicitly (your old special-case)
if ip link show venet0 >/dev/null 2>&1; then
    IPPORT="venet0"
fi

if ip -4 addr show dev "$IPPORT" 2>/dev/null | grep -q inet; then
    eth0="$UP"
else
    eth0="$DN"
fi

#RAM=`free | grep -m 2 ^ | tr -s " " | tail -1 | cut -f 4 -d " "`
RAM=$(free -h | awk '/Mem:/ {print $7}')

#DISK=`df -h | grep /dev/ | tr -s " " | head -n 1 | cut -f 4 -d " "`
DISK=$(df -h / | awk 'NR==2 {print $4}')

if pgrep -f "node.*index\.js" >/dev/null 2>&1; then
    gvoauth="$UP"
else
    gvoauth="$DN"
fi
test=`ps aux | grep -c "node/index.js"`
if [ "$test" -gt "0" ]; then
 gvoauth="$NA"
else
 gvoauth="$NA"
fi

test=`ps aux | grep -c hfaxd`
if [ "$test" -lt "2" ]; then
 hfax="$DN"
else
 hfax="$UP"
fi

test=`ps aux | grep -c openvpn`
if [ "$test" -lt "2" ]; then
 nrclient="$DN"
else
 nrclient="$UP"
fi

test=`ps aux | grep -c faxgetty`
if [ "$test" -lt "2" ]; then
 faxgetty="$DN"
else
 faxgetty="$UP"
fi
test=`ps aux | grep -c iaxmodem`
if [ "$test" -lt "2" ]; then
 iaxmodem="$DN"
else
 iaxmodem="$UP"
fi



TITLE="Incredible PBX $version for $OSrelease"

NOW=`date`

TOP="\n\
\ZbAsterisk\ZB: $asterisk  \ZbApache/$phpversion\ZB: $apache  \Zb  MariaDB\ZB: $mysql\n\
\ZbPostfix\ZB: $sendmail    \ZbIPtables\ZB: $IPtables	\Zb     SSH\ZB: $ssh\n\ 
\ZbLAN port\ZB: $eth0    \ZbFail2Ban\ZB: $fail2ban   \ZbWebmin\ZB: $webmin\n\
\ZbUCP Dmon\ZB: $gvoauth  \Zb PortKnock\ZB: $knockd  \ZbOpenVPN\ZB: $nrclient\n\Zb\n\Zr\Z4\Zb"

MID="RAM\ZB:$RAM  $OSrelease  \ZbDisk\ZB:$DISK \ZR\Z0\n\n\Z5\ZB"
BOT="Asterisk $astversion  Incredible GUI $fpbxversion\ZB\Z0\n\n\Zb$_IP\n\n$_PUBLIC\ZB\n\n\ZbSystem Time: $NOW\Zb"

MSGLEN=`echo ${#MID}`

if [ "$MSGLEN" -gt "67" ]; then
 MID2=`echo $MID| sed -e 's/  / /g'`
 MID=`echo $MID2| sed -e 's/Disk/ Disk/g'`
fi

MSG="$TOP $MID$BOT"

dialog --no-lines --colors --title "$TITLE" --msgbox "$MSG" 20 49

clear -x
